<schema format="0.101.1">
<!-- A small model to start from when writing the XML by hand: a knot, two anchors, a knotted and a historized
     attribute, and a tie. The <metadata> element just below holds the settings of the whole model and has to
     be complete: copy it as it is, and change only what you mean to (the generator sets databaseTarget to Snowflake itself).
     The modeler writes <layout> and <description> elements too; the generator does not need <layout>, and
     <description> becomes a COMMENT. See references/model-xml.md. -->
<metadata changingRange="datetime" encapsulation="public" identity="int" metadataPrefix="Metadata" metadataType="int" metadataUsage="true" changingSuffix="ChangedAt" identitySuffix="ID" positIdentity="int" positGenerator="true" positingRange="datetime" positingSuffix="PositedAt" positorRange="tinyint" positorSuffix="Positor" reliabilityRange="decimal(5,2)" reliabilitySuffix="Reliability" defaultReliability="1" deleteReliability="0" assertionSuffix="Assertion" partitioning="false" entityIntegrity="true" restatability="true" idempotency="false" assertiveness="true" naming="improved" positSuffix="Posit" annexSuffix="Annex" chronon="timestamp_ntz(9)" now="sysdate()" dummySuffix="Dummy" versionSuffix="Version" statementTypeSuffix="StatementType" checksumSuffix="Checksum" businessViews="true" decisiveness="true" equivalence="false" equivalentSuffix="EQ" equivalentRange="tinyint" databaseTarget="Snowflake" temporalization="uni" deletability="false" deletablePrefix="Deletable" deletionSuffix="Deleted" privacy="Ignore" checksum="false" triggers="true" knotAliases="false" naturalKeyAttributes="true"/>
<knot mnemonic="GEN" descriptor="Gender" identity="tinyint" dataRange="varchar(42)">
<metadata capsule="public" generator="false"/>
</knot>
<anchor mnemonic="AC" descriptor="Actor" identity="int">
<metadata capsule="public" generator="true"/>
<attribute mnemonic="NAM" descriptor="Name" timeRange="datetime" dataRange="varchar(42)">
<metadata capsule="public"/>
</attribute>
<attribute mnemonic="GEN" descriptor="Gender" knotRange="GEN">
<metadata capsule="public"/>
</attribute>
</anchor>
<anchor mnemonic="PR" descriptor="Program" identity="int">
<metadata capsule="public" generator="true"/>
</anchor>
<tie>
<role role="part" type="AC" identifier="true"/>
<role role="in" type="PR" identifier="true"/>
<metadata capsule="public"/>
</tie>
</schema>